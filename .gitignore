# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# 模型权重与运行时资源：体积大（几百 MB ~ 数 GB），不入库。
# 目录本身用 .gitkeep 占位，详见 README「资源目录 asset/」。
asset/embedding/*
!asset/embedding/.gitkeep
asset/ollama/*
!asset/ollama/.gitkeep

# DeepSeek 免费公皮（Live2D 模型 + 125 MB PSD 源文件）：体积大且许可要求
# 使用者自行获取，不入库。整个目录忽略，目录本身也不需要占位文件。
asset/live2d/models/DeepSeek免费公皮/

# Environment / secrets
.env
.env.*
!.env.example

# Editors & OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 运行时数据（settings.ini、WebEngine 缓存）：**一定不要入库**
# settings.ini 里有明文的 API Key，别手工 git add -f 它
data/*

# 界面渲染截图等临时产物
_plan_preview/
