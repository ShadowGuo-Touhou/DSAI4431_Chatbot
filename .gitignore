# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# 模型权重与运行时资源：体积大（几百 MB ~ 数 GB），不入库。
# 目录本身用 .gitkeep 占位，详见 README「资源目录 asset/」。
asset/embedding/*
!asset/embedding/.gitkeep
asset/ollama/*
!asset/ollama/.gitkeep
# 语音识别模型（SenseVoice int8 约 228 MB + Silero VAD）：同样不入库，
# 缺失时由启动加载页按需下载（见 gui/loading_page.py 的 speech 行）。
asset/stt/*
!asset/stt/.gitkeep

# DeepSeek 免费公皮（Live2D 模型 + 125 MB PSD 源文件）：体积大且许可要求
# 使用者自行获取，不入库。整个目录忽略，目录本身也不需要占位文件。
asset/live2d/models/DeepSeek免费公皮/

# Environment / secrets
.env
.env.*
!.env.example

# Editors & OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 运行时数据（settings.ini、WebEngine 缓存）：**一定不要入库**
# settings.ini 里有明文的 API Key，别手工 git add -f 它
data/*

# 例外：人格文件（.md）和人格清单是**内容**不是运行时数据，跟代码一起入库
!data/personality/
!data/personality/**

# 界面渲染截图等临时产物
_plan_preview/

# 临时测试目录：tempfile.mkdtemp() 在本机会落到项目根目录，兜一层
dsai_*/
# pip 被中断（或被我 kill 掉）时会在项目根留下一堆解包/元数据临时目录。
# 正常装完 pip 会自己删，但"装到一半连进程一起没了"就不会。
pip-*/

# 知识库内容属于个人笔记：整个目录一律不入库（含 .gitkeep 之外的任何文件）
asset/RAG/
